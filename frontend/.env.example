# ── API connection ───────────────────────────────────────────────────────────
# Local development: keep "/api". Vite forwards it to the backend (see VITE_PROXY_TARGET).
# Production (Vercel etc.): set the deployed backend's URL, e.g. https://your-backend.onrender.com
VITE_API_URL=/api

# Dev only: where the Vite dev server forwards /api. Must match PORT in backend/.env.
# (Port 5000 is used by macOS Control Center, so the backend defaults to 5001.)
VITE_PROXY_TARGET=http://localhost:5001

# ── Google sign-in ───────────────────────────────────────────────────────────
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
