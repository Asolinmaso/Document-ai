# Must match VITE_PROXY_TARGET in frontend/.env (5000 is used by macOS Control Center)
PORT=5001
PGUSER=your_postgres_username
PGPASSWORD=your_postgres_password
PGHOST=localhost
PGDATABASE=your_database_name
PGPORT=5432
# Managed databases (Render, Neon, ...) can use one connection string instead of the PG* values above:
# DATABASE_URL=postgres://user:password@host:5432/dbname

# SMTP Configuration
# Also used for password-reset emails. Without these, reset links are only printed to the server
# log in development, and reset emails fail in production. For Gmail use an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=no-reply@yourdomain.com

# Auth
JWT_SECRET=your_jwt_secret_key_here
# Allowed browser origin(s) for CORS. Comma-separate several; trailing slashes are ignored.
# e.g. FRONTEND_URL=http://localhost:5173,https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Groq LLM
GROQ_API_KEY=gsk_your_groq_api_key_here

# Number of reverse proxies in front of the server (used for per-user rate limiting).
# Defaults to 1 when NODE_ENV=production (Render) and to off otherwise.
# TRUST_PROXY=1
